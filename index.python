import json
import os
import requests

# ================= НАСТРОЙКИ GITHUB =================
GITHUB_USER = "ваш_логин_github"
GITHUB_REPO = "ваше_имя_репозитория"
FOLDER_PATH = "images"  # Папка в репозитории с фото (оставьте "" если фото в корне)
BRANCH = "main"  # Или "master"
# ====================================================


def get_github_image_urls(user, repo, folder="", branch="main"):
    """Получает список прямых (Raw) ссылок на все изображения из папки репозитория GitHub."""
    api_url = f"https://api.github.com/repos/{user}/{repo}/contents/{folder}"
    if branch:
        api_url += f"?ref={branch}"

    response = requests.get(api_url)

    if response.status_code != 200:
        print(
            f"Ошибка доступа к GitHub API ({response.status_code}): {response.json().get('message')}"
        )
        return []

    items = response.json()
    valid_extensions = (".jpg", ".jpeg", ".png", ".webp", ".gif")
    image_urls = []

    for item in items:
        if item.get("type") == "file" and item["name"].lower().endswith(
            valid_extensions
        ):
            # Формируем прямую ссылку на скачивание файла
            raw_url = item.get("download_url")
            image_urls.append(raw_url)

    return image_urls


def generate_html_3d_gallery(image_urls, output_filename="index.html"):
    """Генерирует HTML-файл с Three.js 3D-галереей."""
    urls_json = json.dumps(image_urls, indent=12)

    html_content = f"""<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Галерея GitHub</title>
    <style>
        * {{ box-sizing: border-box; margin: 0; padding: 0; }}
        body {{ overflow: hidden; background-color: #0a0a0f; font-family: 'Segoe UI', Arial, sans-serif; color: #fff; }}
        #canvas-container {{ width: 100vw; height: 100vh; }}
        .ui-overlay {{ position: absolute; top: 20px; left: 50%; transform: translateX(-50%); text-align: center; pointer-events: none; z-index: 10; }}
        .ui-overlay h1 {{ font-size: 2.2rem; letter-spacing: 2px; text-shadow: 0 0 12px rgba(255, 255, 255, 0.4); }}
        .ui-overlay p {{ margin-top: 6px; font-size: 0.95rem; opacity: 0.7; }}
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

    <div class="ui-overlay">
        <h1>3D Галерея из GitHub</h1>
        <p>Вращайте мышью | Масштабируйте колёсиком</p>
    </div>

    <div id="canvas-container"></div>

    <script>
        const photoUrls = {urls_json};

        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0a0a0f, 0.04);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 1.5, 9);

        const renderer = new THREE.WebGLRenderer({{ antialias: true }});
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        document.getElementById('canvas-container').appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 + 0.1;

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 0.5);
        dirLight.position.set(5, 10, 7);
        scene.add(dirLight);

        const galleryGroup = new THREE.Group();
        scene.add(galleryGroup);

        const textureLoader = new THREE.TextureLoader();
        const radius = 5;
        const count = photoUrls.length;

        photoUrls.forEach((url, index) => {{
            textureLoader.load(
                url,
                (texture) => {{
                    const geometry = new THREE.PlaneGeometry(2.4, 3.2);
                    const material = new THREE.MeshStandardMaterial({{
                        map: texture,
                        side: THREE.DoubleSide,
                        roughness: 0.3
                    }});

                    const card = new THREE.Mesh(geometry, material);

                    const angle = (index / count) * Math.PI * 2;
                    card.position.x = Math.sin(angle) * radius;
                    card.position.z = Math.cos(angle) * radius;
                    card.rotation.y = angle;

                    galleryGroup.add(card);
                }},
                undefined,
                (err) => console.error('Ошибка загрузки фото:', url)
            );
        }});

        function animate() {{
            requestAnimationFrame(animate);
            galleryGroup.rotation.y += 0.002;
            controls.update();
            renderer.render(scene, camera);
        }}

        animate();

        window.addEventListener('resize', () => {{
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }});
    </script>
</body>
</html>
"""

    with open(output_filename, "w", encoding="utf-8") as f:
        f.write(html_content)

    print(f"Готово! Файл {output_filename} успешно создан с {len(image_urls)} фото.")


if __name__ == "__main__":
    urls = get_github_image_urls(GITHUB_USER, GITHUB_REPO, FOLDER_PATH, BRANCH)
    if urls:
        generate_html_3d_gallery(urls)
    else:
        print("Изображения в репозитории не найдены.")
